# Basic IDS Signatures for Testing
alert icmp any any -> any any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)
alert tcp any any -> any 5000 (msg:"Potential Dashboard API Probe"; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"Nmap Scan Detected (Generic)"; flow:to_server; flags:S; threshold:type both, track by_src, count 10, seconds 5; sid:1000003; rev:2;)
alert tcp any any -> any any (msg:"Potential SSH Brute Force"; flow:to_server; content:"SSH-2.0-"; threshold:type both, track by_src, count 5, seconds 30; sid:1000004; rev:1;)

# Lab Simulation Rules
alert udp any any -> any any (msg:"UDP Flood/DDoS Simulation Detected"; threshold:type both, track by_src, count 50, seconds 2; sid:1000005; rev:1;)
alert tcp any any -> any any (msg:"SQL Injection Attempt (Lab)"; pcre:"/(\%27)|(\')|(\-\-)|(\%23)|(#)/i"; sid:1000006; rev:1;)
