af-packet:
  - interface: eth0
    cluster-id: 98
    cluster-type: single
    defrag: yes

app-layer:
  protocols:
    tls:
      enabled: yes
      ja3-fingerprints: yes
      detection-ports:
        dp: 443
    http:
      enabled: yes
    dnp3:
      enabled: yes
      detection-ports:
        dp: 20000
    modbus:
      enabled: yes
      detection-ports:
        dp: 502

logging:
  default-log-level: info
  outputs:
  - console:
      enabled: yes
  - file:
      enabled: yes
