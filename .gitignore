# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js / UI ---
node_modules/
ui/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Keep ui/dist/ excluded - rebuilt at runtime by ./start.sh --rebuild
ui/dist/
.pnp
.pnp.js

# --- Machine Learning Models ---
# Binary models ignored by default. Use Git LFS for large files.
models/*.pkl
models/*.joblib
models/*.pth
models/*.h5
models/*.onnx
models/autoencoder.onnx.data
models/backup*/
models/metrics.json
models/retrain_*.txt
models/feature_importance.csv
new model*/

# --- Data & Runtime Logs ---
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-shm
data/*.db-wal
*.csv
data/logs/*.log
data/logs/*.json
data/logs/*.txt
data/logs/*.jsonl
data/logs/*.log*
*.log
*.log*
*.rdb
# Root temporary/log/output files
*_log.txt
*_pid.txt
*_output.txt
test_output*
calibrate_output.txt

# --- Development & Training Scripts ---
# These are used for building/testing but not for running the production system
models/train*.py
models/calibrate*.py
models/test*.py
calibrate*.py
simulate*.py
analyze*.py
debug*.py
/test_*.py
!tests/ # Keep the tests directory structure if needed, but ignore root test scripts
export_local_data.py

# --- Runtime State & Lock Files ---
# Generated by start.sh and setup.sh
.sentinel.lock
.setup.lock
.sentinel_state
.setup_state
scratch/

# --- IDE & System ---
.vscode/
.idea/
.continue/
.pytest_cache/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Environment Variables ---
.env
.env.local
.env.*.local

# --- Documentation & User Files ---
*.md.bak
*.tmp
*.docx
*.pcap
*.pcapng
user/test.pcapng
