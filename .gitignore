# --- Machine Learning Models ---
# We ignore binary models by default. Use LFS if tracking is required.
models/*.pkl
models/*.joblib
models/*.pth
models/*.h5
models/*.onnx

# --- Data & Runtime Logs ---
# Ignore all dynamic data and logs
data/*.db
data/*.sqlite
data/*.sqlite3
data/logs/*.log
data/logs/*.json
data/logs/*.txt
*.log

# --- IDE & System ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Environment Variables ---
.env
.env.local
.env.*.local

# --- Documentation ---
# Keep documentation, ignore backup files
*.md.bak
*.tmp
