# --- Development & Training Scripts ---
# Anchored to root to avoid ignoring working code in subdirectories
/models/train*.py
/models/calibrate*.py
/models/test*.py
/calibrate*.py
/simulate*.py
/analyze*.py
/debug*.py
/test_*.py
!/tests/ 
/export_local_data.py

