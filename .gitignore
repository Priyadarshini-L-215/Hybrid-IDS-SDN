# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js / UI ---
node_modules/
ui/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Keep ui/dist/ excluded - rebuilt at runtime by ./start.sh --rebuild
ui/dist/
.pnp
.pnp.js

# --- Machine Learning Models ---
# Binary models ignored by default. Use Git LFS for large files.
models/*.pkl
models/*.joblib
models/*.pth
models/*.h5
models/*.onnx
models/autoencoder.onnx.data

# --- Data & Runtime Logs ---
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.db-shm
data/*.db-wal
data/logs/*.log
data/logs/*.json
data/logs/*.txt
*.log

# --- Runtime State & Lock Files ---
# Generated by start.sh and setup.sh
.sentinel.lock
.setup.lock
.sentinel_state
.setup_state
scratch/

# --- IDE & System ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Environment Variables ---
.env
.env.local
.env.*.local

# --- Documentation ---
# Keep documentation, ignore backup files
*.md.bak
*.tmp
